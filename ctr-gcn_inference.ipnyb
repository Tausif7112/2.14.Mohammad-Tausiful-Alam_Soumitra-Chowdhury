 reused 48 (delta 48), pack-reused 102 (from 1)\u001b[K\nReceiving objects: 100% (202/202), 1.67 MiB | 19.85 MiB/s, done.\nResolving deltas: 100% (78/78), done.\n/kaggle/working/CTR-GCN\n\nRepository contents:\n['.git', 'torchlight', 'src', 'data', 'ensemble.py', 'main.py', 'feeders', 'LICENSE', 'config', 'requirements.txt', 'model', '.idea', 'README.md', 'graph']\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"from pathlib import Path\n\nconfig_path = Path(\"/kaggle/working/CTR-GCN/config/nturgbd-cross-subject/default.yaml\")\n\nprint(config_path.read_text())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T17:03:07.903480Z","iopub.execute_input":"2026-06-27T17:03:07.903936Z","iopub.status.idle":"2026-06-27T17:03:07.911570Z","shell.execute_reply.started":"2026-06-27T17:03:07.903896Z","shell.execute_reply":"2026-06-27T17:03:07.910508Z"}},"outputs":[{"name":"stdout","text":"work_dir: ./work_dir/ntu60/xsub/ctrgcn_joint\n\n# feeder\nfeeder: feeders.feeder_ntu.Feeder\ntrain_feeder_args:\n  data_path: data/ntu/NTU60_CS.npz\n  split: train\n  debug: False\n  random_choose: False\n  random_shift: False\n  random_move: False\n  window_size: 64\n  normalization: False\n  random_rot: True\n  p_interval: [0.5, 1]\n  vel: False\n  bone: False\n\ntest_feeder_args:\n  data_path: data/ntu/NTU60_CS.npz\n  split: test\n  window_size: 64\n  p_interval: [0.95]\n  vel: False\n  bone: False\n  debug: False\n\n# model\nmodel: model.ctrgcn.Model\nmodel_args:\n  num_class: 60\n  num_point: 25\n  num_person: 2\n  graph: graph.ntu_rgb_d.Graph\n  graph_args:\n    labeling_mode: 'spatial'\n\n#optim\nweight_decay: 0.0004\nbase_lr: 0.1\nlr_decay_rate: 0.1\nstep: [35, 55]\nwarm_up_epoch: 5\n\n# training\ndevice: [0]\nbatch_size: 64\ntest_batch_size: 64\nnum_epoch: 65\nnesterov: True\n\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"import os\n\nsrc = \"/kaggle/input/datasets/oucherifouail/ntu60-processed-skeleton-dataset/ntu60/NTU60_CS.npz\"\ndst_dir = \"/kaggle/working/CTR-GCN/data/ntu\"\ndst = os.path.join(dst_dir, \"NTU60_CS.npz\")\n\nos.makedirs(dst_dir, exist_ok=True)\n\n# Remove any previous file or symlink\nif os.path.lexists(dst):\n    os.remove(dst)\n\nos.symlink(src, dst)\n\nprint(\"Symlink created successfully!\")\n\nprint(\"\\nVerification:\")\nprint(\"Exists:\", os.path.exists(dst))\nprint(\"Is symlink:\", os.path.islink(dst))\nprint(\"Size (GB):\", round(os.path.getsize(dst)/1024**3, 2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T17:04:39.223767Z","iopub.execute_input":"2026-06-27T17:04:39.224297Z","iopub.status.idle":"2026-06-27T17:04:39.235608Z","shell.execute_reply.started":"2026-06-27T17:04:39.224257Z","shell.execute_reply":"2026-06-27T17:04:39.234652Z"}},"outputs":[{"name":"stdout","text":"Symlink created successfully!\n\nVerification:\nExists: True\nIs symlink: True\nSize (GB): 9.51\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"!sed -n '/Pretrained/,$p' README.md","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T17:05:35.154117Z","iopub.execute_input":"2026-06-27T17:05:35.155141Z","iopub.status.idle":"2026-06-27T17:05:35.277308Z","shell.execute_reply.started":"2026-06-27T17:05:35.155101Z","shell.execute_reply":"2026-06-27T17:05:35.276092Z"}},"outputs":[{"name":"stdout","text":"### Pretrained Models\n\n- Download pretrained models for producing the final results on NTU RGB+D 60&120 cross subject [[Google Drive]](https://drive.google.com/drive/folders/1C9XUAgnwrGelvl4mGGVZQW6akiapgdnd?usp=sharing).\n- Put files to <work_dir> and run **Testing** command to produce the final result.\n\n## Acknowledgements\n\nThis repo is based on [2s-AGCN](https://github.com/lshiwjx/2s-AGCN). The data processing is borrowed from [SGN](https://github.com/microsoft/SGN) and [HCN](https://github.com/huguyuehuhu/HCN-pytorch).\n\nThanks to the original authors for their work!\n\n# Citation\n\nPlease cite this work if you find it useful:.\n\n      @inproceedings{chen2021channel,\n        title={Channel-wise Topology Refinement Graph Convolution for Skeleton-Based Action Recognition},\n        author={Chen, Yuxin and Zhang, Ziqi and Yuan, Chunfeng and Li, Bing and Deng, Ying and Hu, Weiming},\n        booktitle={Proceedings of the IEEE/CVF International Conference on Computer Vision},\n        pages={13359--13368},\n        year={2021}\n      }\n\n# Contact\nFor any questions, feel free to contact: `chenyuxin2019@ia.ac.cn`","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"!grep -n \"drive\\|pretrained\\|Google\" README.md","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T17:08:36.182583Z","iopub.execute_input":"2026-06-27T17:08:36.183054Z","iopub.status.idle":"2026-06-27T17:08:36.311228Z","shell.execute_reply.started":"2026-06-27T17:08:36.183014Z","shell.execute_reply":"2026-06-27T17:08:36.309577Z"}},"outputs":[{"name":"stdout","text":"125:- Download pretrained models for producing the final results on NTU RGB+D 60&120 cross subject [[Google Drive]](https://drive.google.com/drive/folders/1C9XUAgnwrGelvl4mGGVZQW6akiapgdnd?usp=sharing).\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"# Install gdown\n!pip -q install gdown\n\n# Download the OFFICIAL pretrained-model folder\nimport gdown\n\ngdown.download_folder(\n    \"https://drive.google.com/drive/folders/1C9XUAgnwrGelvl4mGGVZQW6akiapgdnd\",\n    quiet=False,\n    use_cookies=False\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-27T17:20:04.647246Z","iopub.execute_input":"2026-06-27T17:20:04.647718Z","iopub.status.idle":"2026-06-27T17:21:17.669290Z","shell.execute_reply.started":"2026-06-27T17:20:04.647678Z","shell.execute_reply":"2026-06-27T17:21:17.667863Z"}},"outputs":[{"name":"stderr","text":"Retrieving folder contents\n","output_type":"stream"},{"name":"stdout","text":"Retrieving folder 1jDV3V_yNb